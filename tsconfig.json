{
  "compilerOptions": {
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "types": [
      "node"
    ],
    "baseUrl": ".", // 必须配置，paths 依赖它
    "paths": {
      "@/*": [
        "src/*"
      ] // 将 @/* 映射到 src/* 
    },
    "outDir": "./dist", // tsc 输出目录
    "rootDir": "./src", // 源码根目录
    "module": "NodeNext"
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}