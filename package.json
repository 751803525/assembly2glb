{
  "name": "@chanleeeee/assembly2glb",
  "version": "0.1.5",
  "description": "Convert industrial STEP assemblies to glTF/GLB for web 3D — split, dedup, simplify, and merge large CAD models",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "assembly2glb": "dist/index.js"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && tsc-alias && cpy \"src/**/*.py\" dist --parents",
    "rebuild": "npm run build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prepublishOnly": "npm run rebuild",
    "postversion": "git push && git push --tags"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cad",
    "step",
    "stp",
    "3d",
    "glb",
    "gltf",
    "assembly",
    "opencascade",
    "occ",
    "pythonocc",
    "mesh",
    "optimization",
    "converter",
    "industrial"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/751803525/assembly2glb.git"
  },
  "bugs": {
    "url": "https://github.com/751803525/assembly2glb/issues"
  },
  "homepage": "https://github.com/751803525/assembly2glb#readme",
  "packageManager": "pnpm@9.15.0",
  "tsc-alias": {
    "resolveFullPaths": true,
    "verbose": false
  },
  "license": "MIT",
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "bfj": "^9.1.3",
    "chalk": "^5.3.0",
    "chardet": "^2.2.0",
    "commander": "^12.1.0",
    "fs-extra": "^11.4.0",
    "iconv-lite": "^0.7.3",
    "inquirer": "^10.2.2",
    "meshoptimizer": "^1.2.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.5.5",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "cpy-cli": "^7.0.0",
    "eslint": "^9.10.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
